# AgentPay Guard — environment template. Copy to app/.env.local and fill in.
# NEVER commit real values. Variables without NEXT_PUBLIC_ are server-only.

# --- Cluster / program ---
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public value: deployed to devnet 2026-11-27 (docs/evidence/DEVNET_EVIDENCE.md)
NEXT_PUBLIC_PROGRAM_ID=GvjcbQ2g7dg6ZNNBffhyVLmSz8ncbaEvL2c4M1Esayza
NEXT_PUBLIC_DEMO_MINT=<TEST_MINT_FROM_create-test-mint_SCRIPT>

# --- Agent (server-only, hackathon demo custody) ---
# JSON byte array of the agent keypair, e.g. contents of ~/.config/agentpay/agent.json
AGENT_SECRET_KEY=
# Comma-separated owner public keys whose policies this server agent will serve
ALLOWED_POLICY_OWNERS=

# --- AI ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
FIRECRAWL_API_KEY=

# --- Demo ---
DEMO_MODE=false
DEMO_MERCHANT_WALLET=<FROM_setup-demo_SCRIPT>
DEMO_ATTACKER_WALLET=<FROM_setup-demo_SCRIPT>
DEMO_MALICIOUS_URL=<https://YOUR_DEPLOYMENT/demo/malicious-merchant>

# Optional separate fee payer (T-M4-19): pays network fees; the agent still signs and pays receipt rent.
# Same format as AGENT_SECRET_KEY. Leave empty to let the agent pay fees.
FEE_PAYER_SECRET_KEY=

# --- Wallet session / SIWS (T-M4-16) ---
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`). Required when REQUIRE_OWNER_SESSION=true.
SESSION_SECRET=
# true = payment and agent routes require a signed-in session of the policy owner (401/403 otherwise)
REQUIRE_OWNER_SESSION=false
